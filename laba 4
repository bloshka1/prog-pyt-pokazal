def s(l):
    if 0 < len(l):                    # Если список НЕ пустой
        return l[0] + s(l[1:])        # Первый + сумма остатка
    return 0                          # Пустой список → 0
def m(l, mn):
    if len(l) > 0:                    # Если список НЕ пустой
        if mn > l[0]:                 # Текущий минимум > первый элемент?
            return m(l[1:], l[0])     # Новый минимум = первый элемент
        return m(l[1:], mn)           # Минимум остаётся
    return mn                         # Пустой список → возвращаем минимум
def mx(l, mxn):
    if len(l) > 0:
        if mxn < l[0]:                # Текущий максимум < первый элемент?
            return mx(l[1:], l[0])    # Новый максимум = первый элемент
        return mx(l[1:], mxn)         # Максимум остаётся
    return mxn
l = [10, 3, 2, 1, 4, 5]
res = m(l[1:], l[0])      # m([3,2,1,4,5], 10) → 1
res1 = mx(l[1:], l[0])    # mx([3,2,1,4,5], 10) → 10
print(s(l), res, res1)    # 25 1 10
